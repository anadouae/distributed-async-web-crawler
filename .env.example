# Copy to `.env` and fill in. Never commit `.env`.

# Redis (password form when requirepass is set)
CRAWLER_REDIS_URL=redis://:crawler_redis_secret@localhost:6379/0

# PostgreSQL
CRAWLER_POSTGRES_DSN=postgresql+asyncpg://crawler:crawler@localhost:5432/crawler

# Defaults: real crawl stack (not demo)
CRAWLER_DEMO_MODE=false
CRAWLER_WORKER_COUNT=8
CRAWLER_MAX_CONCURRENCY=256
CRAWLER_MAX_DEPTH=3
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_RUN_SECONDS=30

# SSRF: block private/loopback (127/10/172.16/192.168) unless true
CRAWLER_ALLOW_PRIVATE_NETWORKS=false
# Unprefixed alias also accepted:
# ALLOW_PRIVATE_NETWORKS=false
